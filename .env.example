# Server-side Netlify Function environment variables.
# Tambahkan pada Netlify > Site configuration > Environment variables.

# Supabase project (server-side)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# OpenAI (optional; AI Studio requires this)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-6.2-sol

# Generate with: openssl rand -base64 32
# Keep stable; changing this key makes previously encrypted provider tokens unreadable.
TOKEN_ENCRYPTION_KEY=GENERATE_32_BYTE_BASE64_KEY

# Meta / Instagram Login
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_META_APP_ID
INSTAGRAM_APP_SECRET=YOUR_INSTAGRAM_META_APP_SECRET
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_GRAPH_VERSION=v27.0

# TikTok Login Kit
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET

# Optional local override. Netlify provides URL automatically in deployed Functions.
SITE_URL=https://YOUR_SITE.netlify.app
